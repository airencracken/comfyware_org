# Serve only site/, never the repository root.
{$COMFYWARE_DOMAIN:comfyware.org} {
	root * {$COMFYWARE_ROOT:/srv/comfyware}
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@documents not path /assets/*
	header @documents Cache-Control no-cache
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=3600"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
